          "text": [
            "Enter policy text: This policy defines the scope, roles and responsibilities, and enforcement rules.\n",
            "scope - Present\n",
            "roles - Present\n",
            "responsibilities - Present\n",
            "enforcement - Present\n",
            "review - Missing\n",
            "approval - Missing\n"
          ]
        }
      ],
      "source": [
        "policy = input(\"Enter policy text: \").lower()\n",
        "\n",
        "items = [\"scope\", \"roles\", \"responsibilities\",\n",
        "         \"enforcement\", \"review\", \"approval\"]\n",
        "\n",
        "for item in items:\n",
        "    if item in policy:\n",
        "        print(item, \"- Present\")\n",
        "    else:\n",
        "        print(item, \"- Missing\")"
      ]
    }
  ]
}